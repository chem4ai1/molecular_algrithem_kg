            "name": "AgentDrug",
            "task_type": "molecule_optimization",
            "problems_solved": [],
            "mechanism": "采用嵌套精炼循环：内环利用RDKit检测SMILES语法错误（ParseError）并反馈给LLM以修正分子有效性；外环结合通用反馈与基于梯度的目标信号（gradient signal）引导LLM优化分子属性。同时从数据库检索相似且满足目标的分子作为上下文示例，增强编辑准确性。",
            "why_it_works": "",
            "applicable_to": [],
            "limitations": [
              "依赖外部化学信息学工具包（RDKit）进行验证",
              "需要预构建的分子数据库用于检索"
            ],
            "arch_modules": [
              {
                "name": "LLM Agent",
                "role": "核心推理与生成引擎，执行分子编辑和修正",
                "input": "提示词、反馈信号、上下文示例",
                "output": "修改后的分子SMILES"
              },
              {
                "name": "Cheminformatics Toolkit",
                "role": "分子有效性验证与错误诊断",
                "input": "分子SMILES",
                "output": "有效性状态或ParseError详情"
              }
            ],
            "why_not_other": "ChatDrug仅使用通用反馈，无法有效解决分子幻觉且检索步骤常因无效输出被禁用；AgentDrug通过早期强制有效性和显式梯度信号，使检索更可靠且编辑更精准。",
            "key_challenge": "解决LLM在分子编辑中的“分子幻觉”（生成无效结构）问题，并克服简单提示法准确率有限的问题，同时保持分子结构相似性约束。",
            "modules": [
