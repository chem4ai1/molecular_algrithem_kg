  "research_problem": "提出MolMiner，一种基于片段、几何感知且顺序无关的自回归模型，支持对12个理化性质的高维条件控制分子设计。",
  "domain": "分子生成与从头设计",
  "algorithm_family": "片段/结构化生成",
  "methods": [
    {
      "id": "algorithm:molminer",
      "name": "MolMiner",
      "task_type": "molecule_generation",
      "task_type_label": null,
      "problems_solved": [
        "生成具有特定属性的分子",
        "通过自回归方式构建分子结构"
      ],
      "mechanism": "属性条件自回归模型，通过中间解码状态支持顺序轨迹发散，形成从粗到细的边界。",
      "why_it_works": "固定随机带时保持化学凝聚的局部邻域，中间状态允许逐步细化分子身份。",
      "family": null,
      "relation": "PROPOSES_METHOD"
    },
    {
      "id": "algorithm:chemicalvae",
      "name": "ChemicalVAE",
      "task_type": "molecule_generation",
      "task_type_label": null,
      "problems_solved": [
        "需要可插值、可优化的连续分子隐空间"
      ],
      "mechanism": "CNN 编码 SMILES 到高斯潜空间，RNN 解码重建，KL 约束先验",
      "why_it_works": "连续潜空间支持贝叶斯优化与属性插值",
      "family": null,
      "relation": "RELATED_TO"
    },
    {
      "id": "algorithm:schnet",
      "name": "SchNet",
      "task_type": "forcefield_simulation",
      "task_type_label": null,
      "problems_solved": [
        "从原子坐标直接预测分子能量/性质，无需手工描述符"
      ],
      "mechanism": "连续滤波卷积在原子间距离上做消息传递，聚合得到能量",
      "why_it_works": "距离连续滤波对几何扰动平滑，适合量子化学回归",
      "family": null,
      "relation": "RELATED_TO"
    },
