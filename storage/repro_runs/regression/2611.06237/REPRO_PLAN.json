{
  "paper_id": "paper:2611.06237",
  "arxiv_id": "2611.06237",
  "inputs_sha": "f3be37a2d6556dac",
  "research_problem": "评估SO3LR-T模型在分子相互作用能、金属有机框架(MOFs)力学性质及反应化学过渡态搜索中的精度与适用性",
  "domain": "材料/晶体/分子动力学",
  "algorithm_family": "机器学习势/神经力场",
  "methods": [
    {
      "id": "algorithm:so3lr_tauri",
      "name": "SO3LR Tauri",
      "task_type": "forcefield_simulation",
      "task_type_label": null,
      "problems_solved": [
        "需要可迁移到多种体系的机器学习力场，同时给出能量与力",
        "需要统一建模长程相互作用与短程等变几何"
      ],
      "mechanism": "SO3krates 等变消息传递网络学习短程势，叠加显式长程静电/色散项，在能量与力上联合训练",
      "why_it_works": "等变性保证旋转平移下的物理正确性，显式长程项弥补感受野限制",
      "family": null,
      "relation": "PROPOSES_METHOD"
    },
    {
      "id": "algorithm:so3lr",
      "name": "SO3LR",
      "task_type": "forcefield_simulation",
      "task_type_label": null,
      "problems_solved": [
        "预测全周期表元素覆盖的(生物)分子体系的能量与原子力",
        "模拟反应性生物分子动力学，包括蛋白质-配体相互作用及反应路径"
      ],
      "mechanism": "结合SO3krates消息传递网络捕捉局部几何特征，并显式耦合短程排斥、环境依赖色散及静电等物理相互作用模块，实现几何等变预测。",
      "why_it_works": "消息传递保证局部结构感知与等变性，显式物理项确保长程相互作用（如静电、色散）的物理正确性，兼顾精度与大规模模拟效率。",
      "family": null,
      "relation": "RELATED_TO"
    },
    {
      "id": "algorithm:opls4",
      "name": "OPLS4",
      "task_type": "forcefield_simulation",
      "task_type_label": null,
      "problems_solved": [
        "模拟有机液体密度与扩散系数等宏观物理性质",
        "预测离子水合自由能及肽类质子化自由能",
        "分析生物大分子的结构与动力学行为"
      ],
      "mechanism": "基于参数化解析势函数（经典力场），通过拟合实验数据或量子化学计算结果确定原子间相互作用参数，利用牛顿力学进行分子动力学模拟。",
      "why_it_works": "参数化模型在保持计算效率的同时，能够准确捕捉分子间非共价相互作用（如范德华力、静电作用），从而重现宏观物理化学性质。",
      "family": null,
      "relation": "RELATED_TO"
    },
    {
      "id": "algorithm:gaff",
      "name": "GAFF",
      "task_type": "forcefield_simulation",
      "task_type_label": null,
      "problems_solved": [
        "为有机分子和药物样分子提供原子间相互作用力与能量计算",
        "支持分子动力学模拟以预测宏观物理化学性质"
      ],
      "mechanism": "基于参数化解析势函数（如Lennard-Jones和库仑项），通过预定义的原子类型和参数表计算原子间的非键相互作用，无需量子力学计算。",
      "why_it_works": "利用经验参数拟合量子力学数据，以极低的计算成本近似描述分子间相互作用，适合大规模体系模拟。",
      "family": null,
      "relation": "RELATED_TO"
    },
    {
      "id": "algorithm:mace_polar_1_m",
      "name": "MACE-POLAR-1-M",
      "task_type": "forcefield_simulation",
      "task_type_label": null,
      "problems_solved": [
        "预测极性分子体系的原子级能量与力",
        "支持基于极化效应的分子动力学模拟",
        "作为基础模型用于特定材料（如MOF）的微调"
      ],
      "mechanism": "基于MACE架构的几何等变图神经网络，通过消息传递机制学习原子间相互作用，并显式建模长程静电相互作用（Long-range），以捕捉极性体系中的电荷重分布效应。",
      "why_it_works": "几何等变性保证了物理对称性，长程相互作用项弥补了短程消息传递在静电效应上的不足，从而准确描述极性分子间的非键合相互作用。",
      "family": null,
      "relation": "RELATED_TO"
    },
    {
      "id": "algorithm:aimnet2_2025",
      "name": "AIMNet2-2025",
      "task_type": "forcefield_simulation",
      "task_type_label": null,
      "problems_solved": [
        "预测分子体系的能量、力及偶极矩等物理性质",
        "处理带电体系及非相互作用片段的电荷分配与能量加和性"
      ],
      "mechanism": "基于几何等变图神经网络（GNN），通过消息传递机制聚合原子局部环境特征，利用等变卷积层保持旋转/平移不变性，直接回归能量、力及偶极矩等物理量。",
      "why_it_works": "几何等变性确保模型对分子构象的旋转和平移具有物理一致性，消息传递有效捕捉长程相互作用，从而在保持计算效率的同时实现高精度的能量和力预测。",
      "family": null,
      "relation": "RELATED_TO"
    },
    {
      "id": "algorithm:uma_s_1_2_1",
      "name": "UMA-S-1.2.1",
      "task_type": "forcefield_simulation",
      "task_type_label": null,
      "problems_solved": [
        "预测分子体系的能量和力",
        "处理带电片段间的电荷重分布",
        "评估非相互作用片段的能量可加性"
      ],
      "mechanism": "基于几何等变图神经网络（GNN）进行消息传递，利用几何不变性特征捕捉原子间相互作用，从而预测体系能量及受力。",
      "why_it_works": "几何等变性确保模型对旋转和平移不变，能准确捕捉分子局部几何结构对能量和力的影响，符合物理对称性要求。",
      "family": null,
